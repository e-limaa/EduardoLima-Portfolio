# Copy to a server-side file with mode 600. Never commit filled values.
# Use URI-encoded credentials and keep each value on one line.
DATABASE_URL=postgresql://portfolio_app_staging:replace-me@postgres-apps:5432/portfolio_staging
MIGRATION_DATABASE_URL=postgresql://portfolio_migrator_staging:replace-me@postgres-apps:5432/portfolio_staging
MIGRATION_OWNER_ROLE=portfolio_owner_staging
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8010
PUBLIC_ORIGINS=
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.5
OPENAI_INSTRUCTIONS=
OPENAI_MAX_OUTPUT_TOKENS=220
OPENAI_MAX_OUTPUT_TOKENS_CAP=400
OPENAI_STORE=false
NEWSLETTER_DELIVERY_ENABLED=false
NEWSLETTER_WEBHOOK_URL=https://n8n.elimaj.com.br/webhook/novo-inscrito-newsletter
NEWSLETTER_WEBHOOK_SECRET=
HOST_PORT=8010
PG_POOL_MAX=5
CF_PROXY_CIDRS=
# DNS name of the cloudflared container on n8n_n8n_default (service name or alias).
# Without it every visitor shares one rate-limit bucket behind the tunnel.
CF_PROXY_HOSTS=
SESSION_SECONDS=43200
CHAT_TIMEOUT_MS=30000
CHAT_DAILY_MESSAGES_PER_SESSION=30
CHAT_DAILY_MESSAGES_PER_IP=60
CHAT_CONCURRENCY_PER_IP=2
CHAT_GLOBAL_CONCURRENCY=5
IMPORT_FILE=/home/eduardo/portfolio/portfolio-export.json
IMPORT_UID=1000
IMPORT_GID=1000
VERIFY_DATABASE_URL=postgresql://portfolio_migrator_staging:replace-me@postgres-apps:5432/portfolio_verify
